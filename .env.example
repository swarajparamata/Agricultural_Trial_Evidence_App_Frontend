# Copy this file to `.env` and fill in the values, then restart `npm run dev`.

# Address of the AgriEvidence API (Agricultural_Trial_Evidence_App_Backend).
# Leave it empty to run the offline demo instead: sample trials in the browser, any email signs in
# (emails starting with "admin" get the admin role). The offline demo only runs on the dev server;
# production builds need the API.
VITE_API_BASE_URL=http://127.0.0.1:8000
